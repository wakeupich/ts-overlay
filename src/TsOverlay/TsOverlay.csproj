<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>TsOverlay</AssemblyName>
    <RootNamespace>TsOverlay</RootNamespace>
    <Version>1.1.3</Version>
    <AssemblyTitle>TS Overlay</AssemblyTitle>
    <Product>TS Overlay</Product>
    <Company>AlienNation</Company>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- WPF сам управляет DPI через манифест (PerMonitorV2); предупреждение WinForms-анализатора неактуально. -->
    <NoWarn>WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

</Project>


