<Window x:Class="TsOverlay.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TsOverlay.Controls"
        Title="TS Overlay — настройки"
        Icon="pack://application:,,,/app.ico"
        Width="780"
        Height="660"
        MinWidth="700"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#FFF3F5F8">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="{x:Type controls:SpinBox}" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type controls:SpinBox}">
                        <Border x:Name="SpinBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                </Grid.ColumnDefinitions>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" />
                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <RepeatButton x:Name="PART_Up" Grid.Row="0" Content="▲"
                                                  FontSize="7" Foreground="#FF44506A" Padding="0" Focusable="False"
                                                  BorderThickness="0" Background="Transparent"
                                                  Delay="300" Interval="70" />
                                    <RepeatButton x:Name="PART_Down" Grid.Row="1" Content="▼"
                                                  FontSize="7" Foreground="#FF44506A" Padding="0" Focusable="False"
                                                  BorderThickness="0" Background="Transparent"
                                                  Delay="300" Interval="70" />
                                </Grid>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="SpinBorder" Property="BorderBrush" Value="#FF4C8BF5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ContextMenu x:Key="ColorPaletteMenu">
            <MenuItem Header="Тёмная панель" Tag="#FF1B2430" Click="ColorSwatch_Click">
                <MenuItem.Icon><Border Width="14" Height="14" Background="#FF1B2430" BorderBrush="#FF8899AA" BorderThickness="1" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Почти чёрный" Tag="#FF101418" Click="ColorSwatch_Click">
                <MenuItem.Icon><Border Width="14" Height="14" Background="#FF101418" BorderBrush="#FF8899AA" BorderThickness="1" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Синий вечер" Tag="#FF0E1A2B" Click="ColorSwatch_Click">
                <MenuItem.Icon><Border Width="14" Height="14" Background="#FF0E1A2B" BorderBrush="#FF8899AA" BorderThickness="1" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Тёмно-бордовый" Tag="#FF2B1B1B" Click="ColorSwatch_Click">
                <MenuItem.Icon><Border Width="14" Height="14" Background="#FF2B1B1B" BorderBrush="#FF8899AA" BorderThickness="1" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Светлый текст" Tag="#FFE6EDF7" Click="ColorSwatch_Click">
                <MenuItem.Icon><Border Width="14" Height="14" Background="#FFE6EDF7" BorderBrush="#FF8899AA" BorderThickness="1" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Белый" Tag="#FFFFFFFF" Click="ColorSwatch_Click">
                <MenuItem.Icon><Border Width="14" Height="14" Background="#FFFFFFFF" BorderBrush="#FF8899AA" BorderThickness="1" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Серо-голубой" Tag="#FF9AA7B8" Click="ColorSwatch_Click">
                <MenuItem.Icon><Border Width="14" Height="14" Background="#FF9AA7B8" BorderBrush="#FF8899AA" BorderThickness="1" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Синий" Tag="#FF4C8BF5" Click="ColorSwatch_Click">
                <MenuItem.Icon><Border Width="14" Height="14" Background="#FF4C8BF5" BorderBrush="#FF8899AA" BorderThickness="1" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Зелёный" Tag="#FF3DD68C" Click="ColorSwatch_Click">
                <MenuItem.Icon><Border Width="14" Height="14" Background="#FF3DD68C" BorderBrush="#FF8899AA" BorderThickness="1" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Янтарный" Tag="#FFFFB020" Click="ColorSwatch_Click">
                <MenuItem.Icon><Border Width="14" Height="14" Background="#FFFFB020" BorderBrush="#FF8899AA" BorderThickness="1" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Красный" Tag="#FFFF5C5C" Click="ColorSwatch_Click">
                <MenuItem.Icon><Border Width="14" Height="14" Background="#FFFF5C5C" BorderBrush="#FF8899AA" BorderThickness="1" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Фиолетовый" Tag="#FFB06CFF" Click="ColorSwatch_Click">
                <MenuItem.Icon><Border Width="14" Height="14" Background="#FFB06CFF" BorderBrush="#FF8899AA" BorderThickness="1" /></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="4,2" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="10" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="MainTabs" Grid.Row="0" SelectionChanged="MainTabs_SelectionChanged">

            <!-- ОБЩИЕ -->
            <TabItem Header="Общие">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <GroupBox Header="Клиент TeamSpeak">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Какой клиент использовать" />
                                    <ComboBox x:Name="ClientModeBox" Grid.Column="1">
                                        <ComboBoxItem Tag="Auto" Content="Автоматически (запущенный)" />
                                        <ComboBoxItem Tag="Ts3" Content="Только TeamSpeak 3" />
                                        <ComboBoxItem Tag="Ts6" Content="Только TeamSpeak 6" />
                                    </ComboBox>
                                </Grid>
                                <TextBlock Text="Статус:" FontWeight="SemiBold" Margin="0,4,0,2" />
                                <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="#FF44506A" Margin="0,0,0,6" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Запуск">
                            <StackPanel>
                                <CheckBox x:Name="StartWithWindowsBox" Content="Запускать вместе с Windows" Margin="0,2" />
                                <CheckBox x:Name="AutoLaunchBox" Content="Запускать клиент TeamSpeak вместе с оверлеем" Margin="0,2" />
                                <CheckBox x:Name="ExitWithTsBox" Content="Закрывать оверлей при выходе из TeamSpeak" Margin="0,2" />
                                <CheckBox x:Name="NotifyBox" Content="Показывать уведомления (например, запрос доступа TS6)" Margin="0,2" />
                                <CheckBox x:Name="CheckUpdatesBox" Content="Проверять обновления при запуске" Margin="0,2" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Горячие клавиши">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Показать/скрыть оверлей" />
                                    <TextBox x:Name="HotkeyToggleBox" Grid.Column="1" IsReadOnly="True"
                                             PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Кто говорит (поверх любого окна)" />
                                    <TextBox x:Name="HotkeyHudBox" Grid.Column="1" IsReadOnly="True"
                                             PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                                </Grid>
                                <TextBlock Text="Кликните в поле и нажмите комбинацию. Пустое поле — клавиша отключена."
                                           TextWrapping="Wrap" Foreground="#FF44506A" Margin="0,6,0,0" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Отображение">
                            <StackPanel>
                                <CheckBox x:Name="ShowSelfBox" Content="Показывать себя в списке канала" Margin="0,2" />
                                <CheckBox x:Name="AlwaysShowBox" Content="Поверх любых окон" Margin="0,2" />
                                <TextBlock Text="Оверлей виден поверх любых окон, пока запущена игра из списка. Если список игр пуст — всегда."
                                           TextWrapping="Wrap" Foreground="#FF44506A" Margin="0,6,0,0" />
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ОВЕРЛЕЙ -->
            <TabItem x:Name="OverlayTab" Header="Оверлей">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <GroupBox Header="Положение и размер">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30" />
                                    <RowDefinition Height="30" />
                                    <RowDefinition Height="30" />
                                    <RowDefinition Height="30" />
                                    <RowDefinition Height="30" />
                                    <RowDefinition Height="30" />
                                    <RowDefinition Height="30" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="Угол экрана" />
                                <ComboBox x:Name="AnchorBox" Grid.Column="1">
                                    <ComboBoxItem Tag="TopLeft" Content="Слева сверху" />
                                    <ComboBoxItem Tag="TopCenter" Content="Сверху по центру" />
                                    <ComboBoxItem Tag="TopRight" Content="Справа сверху" />
                                    <ComboBoxItem Tag="LeftCenter" Content="Слева по центру" />
                                    <ComboBoxItem Tag="RightCenter" Content="Справа по центру" />
                                    <ComboBoxItem Tag="BottomLeft" Content="Слева снизу" />
                                    <ComboBoxItem Tag="BottomCenter" Content="Снизу по центру" />
                                    <ComboBoxItem Tag="BottomRight" Content="Справа снизу" />
                                    <ComboBoxItem Tag="Custom" Content="Своя позиция (перетаскиванием)" />
                                </ComboBox>

                                <TextBlock Grid.Column="2" Text="Отступ X / Y" />
                                <Grid Grid.Column="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <controls:SpinBox x:Name="MarginXBox" Step="1" Minimum="-4000" Maximum="4000" />
                                    <controls:SpinBox x:Name="MarginYBox" Grid.Column="2" Step="1" Minimum="-4000" Maximum="4000" />
                                </Grid>

                                <TextBlock Grid.Row="1" Text="Ширина панели" />
                                <controls:SpinBox x:Name="WidthBox" Grid.Row="1" Grid.Column="1" Step="1" Minimum="140" Maximum="900" />

                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Масштаб" />
                                <Grid Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="62" />
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="ScaleSlider" Minimum="0.5" Maximum="3"
                                            SmallChange="0.05" LargeChange="0.1"
                                            VerticalAlignment="Center"
                                            ValueChanged="ScaleSlider_ValueChanged" />
                                    <controls:SpinBox x:Name="ScaleBox" Grid.Column="1" Margin="8,0,0,0"
                                                      Step="0.05" Decimals="2" Minimum="0.5" Maximum="3"
                                                      TextChanged="ScaleBox_TextChanged" />
                                </Grid>

                                <TextBlock Grid.Row="2" Text="Высота строки" />
                                <controls:SpinBox x:Name="RowHeightBox" Grid.Row="2" Grid.Column="1" Step="1" Minimum="16" Maximum="60" />

                                <TextBlock Grid.Row="2" Grid.Column="2" Text="Размер шрифта" />
                                <controls:SpinBox x:Name="FontSizeBox" Grid.Row="2" Grid.Column="3" Step="1" Minimum="8" Maximum="36" />

                                <TextBlock Grid.Row="3" Text="Прозрачность фона" />
                                <Grid Grid.Row="3" Grid.Column="1" Margin="0,0,8,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="OpacitySlider" Minimum="0.2" Maximum="1" SmallChange="0.05"
                                            LargeChange="0.1" VerticalAlignment="Center"
                                            ValueChanged="OpacitySlider_ValueChanged" />
                                    <TextBlock x:Name="OpacityValueText" Grid.Column="1" Width="40"
                                               TextAlignment="Right" VerticalAlignment="Center" />
                                </Grid>

                                <TextBlock Grid.Row="3" Grid.Column="2" Text="Максимум строк" />
                                <controls:SpinBox x:Name="MaxRowsBox" Grid.Row="3" Grid.Column="3" Step="1" Minimum="1" Maximum="64" />

                                <TextBlock Grid.Row="4" Text="Скругление углов" />
                                <controls:SpinBox x:Name="CornerRadiusBox" Grid.Row="4" Grid.Column="1" Step="1" Minimum="0" Maximum="40" />

                                <StackPanel Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="3" Orientation="Horizontal">
                                    <CheckBox x:Name="ShowHeaderBox" Content="Показывать шапку" Margin="0,0,16,0" VerticalAlignment="Center" />
                                    <CheckBox x:Name="ShowServerNameBox" Content="Показывать имя сервера" VerticalAlignment="Center" />
                                </StackPanel>

                                <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal">
                                    <CheckBox x:Name="ShowAvatarsBox" Content="Показывать аватары" Margin="0,0,16,0" VerticalAlignment="Center" />
                                    <CheckBox x:Name="ShowGroupBadgesBox" Content="Показывать значки групп" VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="5"
                                           Text="Перетащить оверлей: зажмите Ctrl+Alt и потяните мышью — позиция сохранится."
                                           Foreground="#FF44506A" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Цвета (HEX: #AARRGGBB)">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="160" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30" />
                                    <RowDefinition Height="30" />
                                    <RowDefinition Height="30" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="Фон панели" />
                                <Grid Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="22" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="BackgroundBox" />
                                    <Button Grid.Column="1" Content="▼" FontSize="7" Padding="0" Focusable="False"
                                            Tag="{Binding ElementName=BackgroundBox}" Click="ColorPalette_Click"
                                            ToolTip="Выбрать из палитры" />
                                </Grid>

                                <TextBlock Grid.Column="3" Text="Текст" />
                                <Grid Grid.Column="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="22" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TextColorBox" />
                                    <Button Grid.Column="1" Content="▼" FontSize="7" Padding="0" Focusable="False"
                                            Tag="{Binding ElementName=TextColorBox}" Click="ColorPalette_Click"
                                            ToolTip="Выбрать из палитры" />
                                </Grid>

                                <TextBlock Grid.Row="1" Text="Приглушённый текст" />
                                <Grid Grid.Row="1" Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="22" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="DimColorBox" />
                                    <Button Grid.Column="1" Content="▼" FontSize="7" Padding="0" Focusable="False"
                                            Tag="{Binding ElementName=DimColorBox}" Click="ColorPalette_Click"
                                            ToolTip="Выбрать из палитры" />
                                </Grid>

                                <TextBlock Grid.Row="1" Grid.Column="3" Text="Говорит" />
                                <Grid Grid.Row="1" Grid.Column="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="22" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TalkingColorBox" />
                                    <Button Grid.Column="1" Content="▼" FontSize="7" Padding="0" Focusable="False"
                                            Tag="{Binding ElementName=TalkingColorBox}" Click="ColorPalette_Click"
                                            ToolTip="Выбрать из палитры" />
                                </Grid>

                                <TextBlock Grid.Row="2" Text="Микрофон выключен" />
                                <Grid Grid.Row="2" Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="22" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="MutedColorBox" />
                                    <Button Grid.Column="1" Content="▼" FontSize="7" Padding="0" Focusable="False"
                                            Tag="{Binding ElementName=MutedColorBox}" Click="ColorPalette_Click"
                                            ToolTip="Выбрать из палитры" />
                                </Grid>
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ИГРЫ -->
            <TabItem Header="Игры">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="#FF44506A" Margin="0,0,0,8"
                               Text="Оверлей появляется только поверх перечисленных игр и только когда окно игры активно. Игру можно добавить по имени процесса." />

                    <ListView x:Name="GamesList" Grid.Row="1" SelectionMode="Extended">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Вкл" Width="50">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Игра" Width="260" DisplayMemberBinding="{Binding DisplayName}" />
                                <GridViewColumn Header="Процесс" Width="220" DisplayMemberBinding="{Binding Exe}" />
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Добавить из запущенных…" Click="OnAddRunning" Padding="10,3" Margin="0,0,8,0" />
                        <Button Content="Указать .exe…" Click="OnBrowseExe" Padding="10,3" Margin="0,0,8,0" />
                        <Button Content="Удалить" Click="OnRemoveGame" Padding="10,3" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ПОДКЛЮЧЕНИЕ -->
            <TabItem Header="Подключение">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <GroupBox Header="TeamSpeak 3 — ClientQuery">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" Foreground="#FF44506A"
                                           Text="В клиенте TS3 должен быть включён плагин ClientQuery (Настройки → Плагины). Ключ можно взять из файла clientquery.ini автоматически." />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Ключ API" />
                                    <TextBox x:Name="Ts3KeyBox" Grid.Column="1" FontFamily="Consolas" />
                                    <Button Grid.Column="2" Content="Взять из ini" Click="OnReadClientQueryKey" Margin="8,0,0,0" Padding="8,3" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Порт" />
                                    <controls:SpinBox x:Name="Ts3PortBox" Grid.Column="1" Step="1" Minimum="1" Maximum="65535" />
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="TeamSpeak 6 — Remote Apps">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" Foreground="#44506A"
                                           Text="При первом подключении TeamSpeak 6 покажет запрос доступа — разрешите его (Настройки → Remote Apps). Ключ выдаётся автоматически и сохраняется здесь." />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Ключ API" />
                                    <TextBox x:Name="Ts6KeyBox" Grid.Column="1" IsReadOnly="True" FontFamily="Consolas" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Порт" />
                                    <controls:SpinBox x:Name="Ts6PortBox" Grid.Column="1" Step="1" Minimum="1" Maximum="65535" />
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Пути к клиентам (если установлены нестандартно)">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30" />
                                    <RowDefinition Height="30" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="TS3" />
                                <TextBox x:Name="Ts3PathBox" Grid.Column="1" />
                                <TextBlock Grid.Row="1" Text="TS6" />
                                <TextBox x:Name="Ts6PathBox" Grid.Row="1" Grid.Column="1" />
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Открыть журнал" Click="OnOpenLog" Padding="10,3" Margin="0,0,8,0" />
            <Button Content="Сохранить" IsDefault="True" Width="110" Padding="10,3" Margin="0,0,8,0" Click="OnSave" />
            <Button Content="Отмена" IsCancel="True" Width="100" Padding="10,3" />
        </StackPanel>
    </Grid>
</Window>



