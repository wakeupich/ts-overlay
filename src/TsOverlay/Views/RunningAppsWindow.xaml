<Window x:Class="TsOverlay.Views.RunningAppsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Loc_Running_Title}"
        Icon="pack://application:,,,/app.ico"
        Width="640"
        Height="480"
        WindowStartupLocation="CenterOwner"
        Background="#FFF3F5F8">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="#FF44506A"
                   Text="{DynamicResource Loc_Running_Desc}" />

        <ListView x:Name="AppsList" Grid.Row="1" SelectionMode="Extended">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="{DynamicResource Loc_Running_Col_Process}" Width="180" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Header="{DynamicResource Loc_Running_Col_Window}" Width="400" DisplayMemberBinding="{Binding Title}" />
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{DynamicResource Loc_Running_Btn_Refresh}" Click="OnRefresh" Padding="10,3" Margin="0,0,8,0" />
            <Button Content="{DynamicResource Loc_Running_Btn_Add}" IsDefault="True" Width="110" Padding="10,3" Margin="0,0,8,0" Click="OnOk" />
            <Button Content="{DynamicResource Loc_Btn_Cancel}" IsCancel="True" Width="100" Padding="10,3" />
        </StackPanel>
    </Grid>
</Window>
