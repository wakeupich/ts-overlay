<Window x:Class="TsOverlay.Views.RunningAppsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить игру из запущенных"
        Icon="pack://application:,,,/app.ico"
        Width="640"
        Height="480"
        WindowStartupLocation="CenterOwner"
        Background="#FFF3F5F8">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="#FF44506A"
                   Text="Выберите окна игр (можно несколько). В список попадёт имя процесса — по нему оверлей и будет находить игру." />

        <ListView x:Name="AppsList" Grid.Row="1" SelectionMode="Extended">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Процесс" Width="180" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Header="Окно" Width="400" DisplayMemberBinding="{Binding Title}" />
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Обновить" Click="OnRefresh" Padding="10,3" Margin="0,0,8,0" />
            <Button Content="Добавить" IsDefault="True" Width="110" Padding="10,3" Margin="0,0,8,0" Click="OnOk" />
            <Button Content="Отмена" IsCancel="True" Width="100" Padding="10,3" />
        </StackPanel>
    </Grid>
</Window>

