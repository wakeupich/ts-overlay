<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="TS Overlay"
           Manufacturer="WakeUpich"
           Version="1.2.2"
           UpgradeCode="8f3c2b1e-7a64-4d9b-9c2e-5e1f0a6d7c31"
           Scope="perUser"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="Установлена более новая версия TS Overlay." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="TSOverlay">
          <Component Id="MainExecutable" Guid="d7b0a1c4-3f5e-4a2b-8c9d-6e7f8a9b0c1d">
            <File Id="TsOverlayExe" Source="$(var.SourceDir)\TsOverlay.exe" KeyPath="yes">
              <Shortcut Id="StartMenuShortcut"
                        Directory="ProgramMenuDir"
                        Name="TS Overlay"
                        Icon="AppIcon"
                        WorkingDirectory="INSTALLFOLDER" />
              <Shortcut Id="DesktopShortcut"
                        Directory="DesktopFolder"
                        Name="TS Overlay"
                        Icon="AppIcon"
                        WorkingDirectory="INSTALLFOLDER" />
            </File>
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ProgramMenuDir" Name="TS Overlay" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="MainFeature" Title="TS Overlay" Level="1">
      <ComponentRef Id="MainExecutable" />
    </Feature>
  </Package>
</Wix>











